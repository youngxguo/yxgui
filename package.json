{
  "name": "yxgui",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/assets/stylex.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "check:quality": "pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:screenshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:screenshots": "pnpm build-storybook && playwright test",
    "test:screenshots:update": "pnpm build-storybook && playwright test --update-snapshots",
    "test:screenshots:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-themes": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@stylexjs/stylex": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "10.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "unplugin": "^2.3.11",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "vitest>vite": "^7.3.1",
      "@vitest/mocker>vite": "^7.3.1"
    }
  }
}
